# Environment files
.env
.env.local
.env.*.local

# API keys
*.key
*.pem
secrets.json

# MCP configs with credentials
mcp-configs/mcp-servers.with_creds.json
mcp-configs/*.with_creds.json

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo

# Node
node_modules/

# Build output
dist/

# Python
__pycache__/
*.pyc

# Task files (Claude Code teams)
tasks/

# Personal configs (if any)
personal/
private/

# Session templates (not committed)
examples/sessions/*.tmp
.claude/settings.local.json

# Local drafts
marketing/

# Per-machine session state (keep in ~/.claude/, not in repo)
sessions/
.tmp/
*.log

# External skills — installed at runtime via scripts/install-external-skills.js
# These are machine-specific symlinks pointing to .skills-cache/; never commit them.
# The manifest (scripts/external-skills.json) is the source of truth.
skills/playwright-skill
skills/humanizer
skills/typescript-expert
skills/agent-browser
skills/ascii-visualizer
skills/fastapi-async-patterns
skills/find-skills

# But DO commit learned skills (shared knowledge across machines)
# skills/learned/ is intentionally tracked

# Continuous Learning v2 - exclude noisy/personal files
homunculus/observations.jsonl
homunculus/.observer.pid
homunculus/observer.log
homunculus/instincts/personal/

# v2 - commit these (shared knowledge):
# homunculus/instincts/inherited/
# homunculus/evolved/
# homunculus/observations.archive/ (optional)
