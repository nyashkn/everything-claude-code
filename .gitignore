skills/humanizer
skills/typescript-expert
skills/agent-browser
skills/ascii-visualizer
skills/fastapi-async-patterns
skills/find-skills

# But DO commit learned skills (shared knowledge across machines)
# skills/learned/ is intentionally tracked

