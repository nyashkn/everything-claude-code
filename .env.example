# ============================================
# MCP Server Credentials
# ============================================
# This file is a template. Copy to .env and replace placeholders with actual values.
# .env is in .gitignore - safe to store secrets there.

# --------------------------------------------
# GitHub MCP - Required for GitHub operations
# --------------------------------------------
# Get from: https://github.com/settings/tokens (Personal access tokens)
# Scopes needed: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_GITHUB_PAT_HERE

# --------------------------------------------
# Tavily MCP - Search and research
# --------------------------------------------
# Get from: https://tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE

# --------------------------------------------
# Firecrawl MCP - Web scraping
# --------------------------------------------
# Get from: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_KEY_HERE

# --------------------------------------------
# Supabase MCP - Optional
# --------------------------------------------
# Note: Supabase uses project reference as a CLI argument in mcp-servers.json:
#   "args": ["--project-ref=YOUR_PROJECT_REF"]
# You can either:
#   1. Set SUPABASE_PROJECT_REF here (setup-mcp.js will inject it)
#   2. Edit mcp-servers.json directly
# Get project ref from: https://supabase.com/dashboard/project/_/settings/general
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# --------------------------------------------
# Optional: Add your project-specific variables below
# --------------------------------------------
